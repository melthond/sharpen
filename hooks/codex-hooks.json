{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-session.js\"",
            "timeout": 5,
            "statusMessage": "Loading Sharpen..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-prompt.js\"",
            "timeout": 5,
            "statusMessage": "Sharpening prompt..."
          }
        ]
      }
    ]
  }
}
